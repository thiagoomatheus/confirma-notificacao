generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id                String       @id @default(uuid())
  email             String       @unique
  instanciaWhatsApp String?
  nome              String
  mensagens Mensagem[]
  notificacao Notificacao[]

  @@map("usuarios")
}

model Mensagem {
  id String @id @default(uuid())
  idUsuario String
  usuarioReference Usuario @relation(fields: [idUsuario], references: [id])
  assunto String
  saudacao String?
  saudacaoNome Boolean
  corpo String
  lembreteLocal Boolean
  localFixo String?
  obs Boolean
  obsFixo String?
  chamadaParaAcao String?
  opcoes Json?
  totalNotificacoes Int @default(0)
  notificacoesEnviadas Int @default(0)
  notificacoes Notificacao[]
}

model Notificacao {
  id String @id @default(uuid())
  idUsuario String
  usuarioReference Usuario @relation(fields: [idUsuario], references: [id])
  idMensagem String
  mensagemReference Mensagem @relation(fields: [idMensagem], references: [id])
  nome String?
  data DateTime
  hora String
  local String?
  obsTexto String?
  dataEnvio DateTime
  horaEnvio String
  telefone String
  status Boolean
}